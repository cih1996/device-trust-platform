limit_req_zone $binary_remote_addr zone=dtp_api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=dtp_login:1m rate=5r/m;

server {
    listen 80;
    listen [::]:80;
    server_name devicetrust.lingzidev.com devicetrust-console.lingzidev.com devicetrust-sdk-api.lingzidev.com;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name devicetrust.lingzidev.com;
    ssl_certificate /etc/nginx/ssl/devicetrust/devicetrust.lingzidev.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/devicetrust/devicetrust.lingzidev.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/devicetrust/current/site;
    index index.html;
    access_log /var/log/nginx/devicetrust-site.access.log;
    error_log /var/log/nginx/devicetrust-site.error.log;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'" always;
    location / { try_files $uri $uri/ =404; }
    location /downloads/ { autoindex off; try_files $uri =404; }
    location ~ /\. { return 404; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name devicetrust-console.lingzidev.com;
    ssl_certificate /etc/nginx/ssl/devicetrust/devicetrust-console.lingzidev.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/devicetrust/devicetrust-console.lingzidev.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/devicetrust/current/web;
    index index.html;
    client_max_body_size 256k;
    access_log /var/log/nginx/devicetrust-console.access.log;
    error_log /var/log/nginx/devicetrust-console.error.log;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location /api/ {
        limit_req zone=dtp_api burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:18191;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / { try_files $uri $uri/ =404; }
    location ~ /\. { return 404; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name devicetrust-sdk-api.lingzidev.com;
    ssl_certificate /etc/nginx/ssl/devicetrust/devicetrust-sdk-api.lingzidev.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/devicetrust/devicetrust-sdk-api.lingzidev.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;
    access_log /var/log/nginx/devicetrust-api.access.log;
    error_log /var/log/nginx/devicetrust-api.error.log;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control no-store always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 90s;
    location /v1/ {
        limit_req zone=dtp_api burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:18191;
    }
    location = /health { proxy_pass http://127.0.0.1:18191; }
    location = /demo/login {
        limit_req zone=dtp_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:18192/login;
    }
    location /demo/ {
        limit_req zone=dtp_api burst=60 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:18192/;
    }
    location / { return 404; }
}

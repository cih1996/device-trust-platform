[Unit]
Description=DeviceTrust platform
After=network-online.target
Wants=network-online.target
[Service]
User=devicetrust
Group=devicetrust
WorkingDirectory=/opt/devicetrust/current
ExecStart=/opt/devicetrust/current/bin/server -addr 127.0.0.1:18191 -data /var/lib/devicetrust/platform -web /opt/devicetrust/current/web -admin-token-file /var/lib/devicetrust/admin-token -attestation-roots /var/lib/devicetrust/trust/attestation-roots.pem -attestation-revocations /var/lib/devicetrust/trust/attestation-status.json -trusted-loopback-proxy -resource-catalog /opt/devicetrust/current/resources/catalog.json -ip-v4 /opt/devicetrust/current/resources/ip2region_v4.xdb -ip-v6 /opt/devicetrust/current/resources/ip2region_v6.xdb -cell-db /var/lib/devicetrust/cells/460.csv.gz
Restart=on-failure
RestartSec=3
StateDirectory=devicetrust
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
[Install]
WantedBy=multi-user.target
